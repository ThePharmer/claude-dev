#!/usr/bin/env bash
#
# Password-secret bridge for the Paseo daemon.
#
# Paseo v0.1.110 reads ONLY the PASEO_PASSWORD env var (server config.ts) - it does NOT
# read PASEO_PASSWORD_FILE. A Docker/Compose secret is delivered as a file, so without this
# bridge the mounted secret is silently ignored and the daemon starts UNAUTHENTICATED
# (it only logs a warning; /api/health still returns 200 and hides it). Since this daemon is
# reachable over a public Cloudflare tunnel, an unauthenticated start is a hard failure here.
#
# This runs as root (before the base entrypoint drops to the 'paseo' user via gosu), reads
# the secret file, exports PASEO_PASSWORD, then execs the stock Paseo entrypoint unchanged.
set -euo pipefail

if [[ -z "${PASEO_PASSWORD:-}" && -n "${PASEO_PASSWORD_FILE:-}" && -f "${PASEO_PASSWORD_FILE}" ]]; then
    PASEO_PASSWORD="$(cat "${PASEO_PASSWORD_FILE}")"
    export PASEO_PASSWORD
fi

# Fail closed: never let the public daemon come up without a password.
if [[ -z "${PASEO_PASSWORD:-}" ]]; then
    echo "[paseo-password-entrypoint] FATAL: no PASEO_PASSWORD (or readable PASEO_PASSWORD_FILE)." >&2
    echo "[paseo-password-entrypoint] Refusing to start a tunnel-reachable daemon unauthenticated." >&2
    exit 1
fi

exec /usr/local/bin/paseo-docker-entrypoint "$@"
